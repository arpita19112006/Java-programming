               }

               var1.printf("Total employees: %d\n", this.empList.size());
               var1.printf("Average salary: %s\n", this.formatSalary(this.getAverageSalary()));
               this.setStatus("Exported data to employees_report.txt.");
            } catch (Throwable var5) {
               try {
                  var1.close();
               } catch (Throwable var4) {
                  var5.addSuppressed(var4);
               }

               throw var5;
            }

            var1.close();
         } catch (IOException var6) {
            this.setStatus("Failed to export data: " + var6.getMessage());
         }

      }
   }

   private void refreshTable() {
      this.tableModel.setRowCount(0);

      for(Employee var2 : this.empList) {
         this.addRow(var2);
      }

      this.updateSummary();
   }

   private void addRow(Employee var1) {
      this.tableModel.addRow(new Object[]{var1.getId(), var1.getName(), var1.getRole(), var1.getDepartment(), var1.getEmail(), var1.getPhone(), var1.getJoiningDate().format(DATE_FORMAT), this.formatSalary(var1.getSalary())});
   }

   private void clearInputs() {
      this.idField.setText("");
      this.nameField.setText("");
      this.roleCombo.setSelectedIndex(0);
      this.departmentField.setText("");
      this.emailField.setText("");
      this.phoneField.setText("");
      this.joiningField.setText("");
      this.salaryField.setText("");
      this.bonusField.setText("10");
      this.taxField.setText("12");
      this.incrementField.setText("5");
      this.searchField.setText("");
      this.employeeTable.clearSelection();
      this.netSalaryLabel.setText("Net Salary: 0.00");
      this.setStatus("Inputs cleared.");
   }

   private Employee findEmployeeById(int var1) {
      for(Employee var3 : this.empList) {
         if (var3.getId() == var1) {
            return var3;
         }
      }

      return null;
   }

   private void updateSummary() {
      int var1 = this.empList.size();
      double var2 = this.getAverageSalary();
      this.summaryLabel.setText(String.format("Employees: %d | Avg Salary: %s", var1, this.formatSalary(var2)));
   }

   private double getAverageSalary() {
      return this.empList.isEmpty() ? (double)0.0F : this.empList.stream().mapToDouble(Employee::getSalary).average().orElse((double)0.0F);
   }

   private String formatSalary(double var1) {
      return String.format("%.2f", var1);
   }

   private void setStatus(String var1) {
      this.statusLabel.setText(var1);
   }

   public static void main(String[] var0) {
      SwingUtilities.invokeLater(EmployeeManagementSystem::new);
   }

   static {
      DATE_FORMAT = DateTimeFormatter.ISO_LOCAL_DATE;
   }
}
